<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
	<type>fa</type>
	<automaton>
		<state id="0" name="q0"><x>100.0</x><y>200.0</y><initial/></state>
		<state id="1" name="q_cbaabb"><x>300.0</x><y>100.0</y></state>
		<state id="2" name="q_abbcb"><x>300.0</x><y>300.0</y></state>
		<state id="3" name="q_cbaabb_cb"><x>500.0</x><y>100.0</y></state>
		<state id="4" name="q_ACCEPT"><x>700.0</x><y>200.0</y><final/></state>
		
		<transition><from>0</from><to>0</to><read>a</read></transition>
		<transition><from>0</from><to>0</to><read>b</read></transition>
		<transition><from>0</from><to>0</to><read>c</read></transition>
		<transition><from>0</from><to>0</to><read>0</read></transition>
		<transition><from>0</from><to>0</to><read>1</read></transition>
		
		<transition><from>0</from><to>1</to><read>a</read></transition>
		<transition><from>0</from><to>2</to><read>c</read></transition>
		
		<!-- Traslape: cbaabb contiene 'abb' en el sufijo, con leer 'c' y 'b' se completa abbcb -->
		<transition><from>1</from><to>3</to><read>c</read></transition>
		<transition><from>3</from><to>4</to><read>b</read></transition>
		
		<!-- Bucle de aceptación general -->
		<transition><from>4</from><to>4</to><read>a</read></transition>
		<transition><from>4</from><to>4</to><read>b</read></transition>
		<transition><from>4</from><to>4</to><read>c</read></transition>
		<transition><from>4</from><to>4</to><read>0</read></transition>
		<transition><from>4</from><to>4</to><read>1</read></transition>
	</automaton>
</structure>