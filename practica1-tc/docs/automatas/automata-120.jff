<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
	<type>fa</type>
	<automaton>
		<state id="0" name="q0"><x>100.0</x><y>250.0</y><initial/></state>
		<state id="1" name="q_0start"><x>300.0</x><y>100.0</y></state>
		<state id="2" name="q_0ok"><x>500.0</x><y>100.0</y><final/></state>
		<state id="3" name="q_1start"><x>300.0</x><y>250.0</y></state>
		<state id="4" name="q_1ok"><x>500.0</x><y>250.0</y><final/></state>
		<state id="5" name="q_2start"><x>300.0</x><y>400.0</y></state>
		<state id="6" name="q_2ok"><x>500.0</x><y>400.0</y><final/></state>
		
		<!-- Transiciones desde el estado inicial -->
		<transition><from>0</from><to>1</to><read>0</read></transition>
		<transition><from>0</from><to>3</to><read>1</read></transition>
		<transition><from>0</from><to>5</to><read>2</read></transition>
		
		<!-- Rama inició con 0 -->
		<transition><from>1</from><to>1</to><read>0</read></transition>
		<transition><from>1</from><to>2</to><read>1</read></transition>
		<transition><from>1</from><to>2</to><read>2</read></transition>
		<transition><from>2</from><to>1</to><read>0</read></transition>
		<transition><from>2</from><to>2</to><read>1</read></transition>
		<transition><from>2</from><to>2</to><read>2</read></transition>
		
		<!-- Rama inició con 1 -->
		<transition><from>3</from><to>3</to><read>1</read></transition>
		<transition><from>3</from><to>4</to><read>0</read></transition>
		<transition><from>3</from><to>4</to><read>2</read></transition>
		<transition><from>4</from><to>3</to><read>1</read></transition>
		<transition><from>4</from><to>4</to><read>0</read></transition>
		<transition><from>4</from><to>4</to><read>2</read></transition>
		
		<!-- Rama inició con 2 -->
		<transition><from>5</from><to>5</to><read>2</read></transition>
		<transition><from>5</from><to>6</to><read>0</read></transition>
		<transition><from>5</from><to>6</to><read>1</read></transition>
		<transition><from>6</from><to>5</to><read>2</read></transition>
		<transition><from>6</from><to>6</to><read>0</read></transition>
		<transition><from>6</from><to>6</to><read>1</read></transition>
	</automaton>
</structure>