<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
	<type>fa</type>
	<automaton>
		<state id="0" name="q0"><x>100.0</x><y>150.0</y><initial/></state>
		<state id="1" name="q_0a"><x>200.0</x><y>150.0</y></state>
		<state id="2" name="q_01a"><x>300.0</x><y>150.0</y></state>
		<state id="3" name="q_1st"><x>400.0</x><y>150.0</y></state>
		<state id="4" name="q_0b"><x>500.0</x><y>150.0</y></state>
		<state id="5" name="q_01b"><x>600.0</x><y>150.0</y></state>
		<state id="6" name="q_2nd"><x>700.0</x><y>150.0</y><final/></state>
		
		<!-- Búsqueda primer 010 -->
		<transition><from>0</from><to>0</to><read>1</read></transition>
		<transition><from>0</from><to>0</to><read>2</read></transition>
		<transition><from>0</from><to>1</to><read>0</read></transition>
		<transition><from>1</from><to>1</to><read>0</read></transition>
		<transition><from>1</from><to>0</to><read>2</read></transition>
		<transition><from>1</from><to>2</to><read>1</read></transition>
		<transition><from>2</from><to>0</to><read>1</read></transition>
		<transition><from>2</from><to>0</to><read>2</read></transition>
		<transition><from>2</from><to>3</to><read>0</read></transition>
		
		<!-- Búsqueda segundo 010 (sin reocupar el último '0') -->
		<transition><from>3</from><to>3</to><read>1</read></transition>
		<transition><from>3</from><to>3</to><read>2</read></transition>
		<transition><from>3</from><to>4</to><read>0</read></transition>
		<transition><from>4</from><to>4</to><read>0</read></transition>
		<transition><from>4</from><to>3</to><read>2</read></transition>
		<transition><from>4</from><to>5</to><read>1</read></transition>
		<transition><from>5</from><to>3</to><read>1</read></transition>
		<transition><from>5</from><to>3</to><read>2</read></transition>
		<transition><from>5</from><to>6</to><read>0</read></transition>
		
		<!-- Aceptación -->
		<transition><from>6</from><to>6</to><read>0</read></transition>
		<transition><from>6</from><to>6</to><read>1</read></transition>
		<transition><from>6</from><to>6</to><read>2</read></transition>
	</automaton>
</structure>