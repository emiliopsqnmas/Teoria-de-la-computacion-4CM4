<structure>
	<type>fa</type>
	<automaton>
		<state id="0" name="q0"><x>100.0</x><y>150.0</y><initial/></state>
		<state id="1" name="q_0"><x>200.0</x><y>150.0</y></state>
		<state id="2" name="q_01"><x>300.0</x><y>150.0</y></state>
		<state id="3" name="q_1st_010"><x>400.0</x><y>150.0</y></state>
		<state id="4" name="q_1st_0101"><x>550.0</x><y>150.0</y></state>
		<state id="5" name="q_2nd_010"><x>700.0</x><y>150.0</y><final/></state>
		
		<transition><from>0</from><to>0</to><read>1</read></transition>
		<transition><from>0</from><to>0</to><read>2</read></transition>
		<transition><from>0</from><to>1</to><read>0</read></transition>
		<transition><from>1</from><to>1</to><read>0</read></transition>
		<transition><from>1</from><to>0</to><read>2</read></transition>
		<transition><from>1</from><to>2</to><read>1</read></transition>
		<transition><from>2</from><to>0</to><read>1</read></transition>
		<transition><from>2</from><to>0</to><read>2</read></transition>
		<transition><from>2</from><to>3</to><read>0</read></transition>
		
		<!-- Traslape directo: estando en 3 (ya leyó 010), el '0' sirve como inicio del segundo -->
		<transition><from>3</from><to>3</to><read>0</read></transition>
		<transition><from>3</from><to>0</to><read>2</read></transition>
		<transition><from>3</from><to>4</to><read>1</read></transition>
		<transition><from>4</from><to>0</to><read>1</read></transition>
		<transition><from>4</from><to>0</to><read>2</read></transition>
		<transition><from>4</from><to>5</to><read>0</read></transition>
		
		<transition><from>5</from><to>5</to><read>0</read></transition>
		<transition><from>5</from><to>5</to><read>1</read></transition>
		<transition><from>5</from><to>5</to><read>2</read></transition>
	</automaton>
</structure>