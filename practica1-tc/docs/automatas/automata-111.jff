<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
	<type>fa</type>
	<automaton>
		<state id="0" name="c0"><x>100.0</x><y>150.0</y><initial/></state>
		<state id="1" name="c1"><x>250.0</x><y>150.0</y></state>
		<state id="2" name="c2"><x>400.0</x><y>150.0</y></state>
		<state id="3" name="c3"><x>550.0</x><y>150.0</y><final/></state>
		<state id="4" name="q_trap"><x>700.0</x><y>150.0</y></state>
		
		<!-- Conteo progresivo -->
		<transition><from>0</from><to>0</to><read>0</read></transition>
		<transition><from>0</from><to>0</to><read>1</read></transition>
		<transition><from>0</from><to>0</to><read>2</read></transition>
		<transition><from>0</from><to>1</to><read>2</read></transition>
		
		<transition><from>1</from><to>1</to><read>0</read></transition>
		<transition><from>1</from><to>1</to><read>1</read></transition>
		<transition><from>1</from><to>1</to><read>2</read></transition>
		<transition><from>1</from><to>2</to><read>2</read></transition>
		
		<transition><from>2</from><to>2</to><read>0</read></transition>
		<transition><from>2</from><to>2</to><read>1</read></transition>
		<transition><from>2</from><to>2</to><read>2</read></transition>
		<transition><from>2</from><to>3</to><read>2</read></transition>
		
		<!-- Aceptación: Mantenerse en c3 si no aparece una 4ta ocurrencia -->
		<transition><from>3</from><to>3</to><read>0</read></transition>
		<transition><from>3</from><to>3</to><read>1</read></transition>
		
		<!-- Transición a estado trampa al detectar una 4ta ocurrencia -->
		<transition><from>3</from><to>4</to><read>2</read></transition>
		<transition><from>4</from><to>4</to><read>0</read></transition>
		<transition><from>4</from><to>4</to><read>1</read></transition>
		<transition><from>4</from><to>4</to><read>2</read></transition>
	</automaton>
</structure>